# Copy these values into your shell environment or IntelliJ Run Configuration.
DB_URL=jdbc:mysql://localhost:3306/ai_tutor?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRATION=86400000
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Local code-runner settings. Keep the runner disabled for an exposed production deployment
# unless the sandbox has been separately reviewed.
CODE_RUNNER_ENABLED=true
CODE_RUNNER_TIMEOUT_SECONDS=5
CODE_RUNNER_MEMORY_MB=256
